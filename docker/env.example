# EVM Oracle Demo — environment template.
#
# LOCAL:  cp docker/env.example docker/.env  then edit.  `docker compose -f
#         docker/docker-compose.yml up -d` auto-reads docker/.env.
# PROD:   clone the repo on the VPS, `cp docker/env.example docker/.env`,
#         fill the values, then
#         `docker compose -f docker/docker-compose.yml \
#                         -f docker/docker-compose.prod.yml up -d`.
#
# docker/.env is gitignored. Keep the real reporter keys + API keys out of git.

# ===========================================================================
# Local host ports (dev/base compose only — prod resets all of these)
# ===========================================================================
# Each service is published on the host in local mode so you can reach it
# directly without a proxy. Override here if a port collides with something
# already running on your machine (e.g. a local postgres on 5432).
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
PRICE_GRPC_PORT=50051
PRICE_HEALTHZ_PORT=8082
INDEXER_GRPC_PORT=9090
INDEXER_HEALTHZ_PORT=8083
ORACLE_GRPC_PORT=9091
ORACLE_HEALTHZ_PORT=8084
API_HOST_PORT=8080
API_HEALTHZ_PORT=8081

# ===========================================================================
# Caddy / TLS (production, or local `--profile tls`)
# ===========================================================================
# Caddy is OFF in local mode. Production (docker-compose.prod.yml) force-
# enables it as the single public surface and is the only thing that binds
# the host (80/443).
#
# DOMAIN governs Caddy's site address. "localhost" → internal CA (testing).
# A real apex/subdomain + a non-"internal" CADDY_EMAIL → Let's Encrypt.
DOMAIN=localhost
CADDY_EMAIL=internal
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443

# ===========================================================================
# Database (single postgres instance, 3 databases per architecture rule 7)
# ===========================================================================
POSTGRES_ROOT_PASSWORD=change_me_root
PRICE_DB_PASSWORD=change_me_price
ORACLE_DB_PASSWORD=change_me_oracle
INDEXER_DB_PASSWORD=change_me_indexer

# ===========================================================================
# Chain (defaults to Ethereum Sepolia — matches contracts/main/deployments/)
# ===========================================================================
CHAIN_NAME=ethereum-sepolia
CHAIN_CHAIN_ID=11155111

# Operator MUST supply WS + HTTPS endpoints. Free options:
#   - Alchemy: wss://eth-sepolia.g.alchemy.com/v2/<key>
#   - Infura:  wss://sepolia.infura.io/ws/v3/<key>
#   - public:  wss://ethereum-sepolia-rpc.publicnode.com (rate-limited; the
#              public node blocks multi-address eth_getLogs, so deep backfills
#              are slow — fine for live events, use a keyed RPC for history)
CHAIN_WS_URL=
CHAIN_RPC_URL=

# Registry contract address — from contracts repo deployments/ethereum-sepolia/
CHAIN_REGISTRY_ADDRESS=0x89a6c12a403733c6a817472cec46a530581cb7ef

# Indexer backfill start block. 0 = full chain scan (slow). Set to a block
# near the contracts' deployment (see deployments/ethereum-sepolia/*.json) to
# only replay recent history.
INDEXER_BACKFILL_FROM_BLOCK=0

# ===========================================================================
# Aggregator addresses (oracle-service: required, non-empty JSON map)
# ===========================================================================
# Values from repos/evm-oracle-demo-contracts/deployments/ethereum-sepolia/
# Format: JSON object mapping lower-case symbol -> 0x-prefixed address.
# Regenerate via `scripts/seed-assets.sh --emit-env-map` after a fresh deploy.
CHAIN_AGGREGATOR_ADDRESSES={"weth":"0x075be31662c2548c4e940d7e769c328a34dcb281","wbtc":"0xf8ad3a2505eece7ad276db038c7c56930bd436e4","link":"0xecc43e6ec38ce135b81ae8042df96eef55915d14","uni":"0x69d16087172f404925ffc61c0ac25c608ff215b4","aave":"0xa011fa0757b5d2a9a4c73cfb4647c29d96da7a2f","xau":"0x61125ef037305e4b81c5e5a864225860f455d318","xag":"0x4e05cc443cbcd5425b5b7c7df124101ad70b8b02","spx":"0x3fa9e3fd3e5e70f26ccf4b67825489276f9cbb27","wti":"0x70131a2612682f7d56a2a30010075e8f0e9d8eca","hg":"0x87249f3aeb58c46be3f5edd1d5071ee76d816900"}

# ===========================================================================
# Reporter signer (oracle-service)
# ===========================================================================
# Paths inside the container. Files are mounted read-only from the host
# secrets directory (REPORTER_SECRETS_DIR). See docs/SECURITY.md + secrets/.
SIGNER_REPORTER_KEY_PATHS=["/etc/lighthouse/secrets/reporter1.key","/etc/lighthouse/secrets/reporter2.key","/etc/lighthouse/secrets/reporter3.key"]
SIGNER_THRESHOLD=2
# Dev convenience only — never true in production.
SIGNER_ALLOW_INSECURE_PERMS=false
# Number of async fetch+sign workers. Safe to raise: a single sender goroutine
# serialises the on-chain broadcast + nonce, so workers never race the nonce.
SUBMISSION_WORKERS=4

# Host directory holding reporter1.key / reporter2.key / reporter3.key.
# Relative paths resolve against `docker/` (the compose file's dir), so
# `../secrets` = repo-root secrets/. In production use the absolute path
# /etc/lighthouse/secrets.
REPORTER_SECRETS_DIR=../secrets

# ===========================================================================
# Oracle heartbeat
# ===========================================================================
HEARTBEAT_ENABLED=true
HEARTBEAT_INTERVAL_SEC=3600
HEARTBEAT_DEVIATION_THRESHOLD=0.015

# ===========================================================================
# Price-service data sources
# ===========================================================================
# Keyless sources (always on, no key): CoinGecko, Binance, gold-api, Yahoo,
# Swissquote. The service refuses to start if an *enabled* keyed source has
# no key.
#
# Keyed + enabled by default → REQUIRED:
#   uniswap_v3   — The Graph Gateway:  https://thegraph.com/studio/
#   alpha_vantage —                    https://www.alphavantage.co/support/#api-key
SOURCES_UNISWAP_V3_API_KEY=
SOURCES_ALPHA_VANTAGE_API_KEY=

# Keyed + DISABLED by default → optional. twelve_data ships disabled; supply a
# key only if you also flip it on in the service config.
#   Twelve Data: https://twelvedata.com/pricing
SOURCES_TWELVE_DATA_API_KEY=

# EIA + FRED are disabled here so the stack boots with just the two keys
# above. Both are free — register, paste the key, set ENABLED=true to add
# energy (EIA) / macro (FRED) coverage.
#   EIA:  https://www.eia.gov/opendata/register.php
#   FRED: https://fred.stlouisfed.org/docs/api/api_key.html
SOURCES_EIA_ENABLED=false
SOURCES_EIA_API_KEY=
SOURCES_FRED_ENABLED=false
SOURCES_FRED_API_KEY=

# ===========================================================================
# REST API
# ===========================================================================
HTTP_CORS_ORIGINS=["http://localhost:3000"]
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60
AUTHOR_NAME=Andrei Solovov
CHAIN_EXPLORER_URL_PATTERN=https://sepolia.etherscan.io/tx/{tx_hash}

# ===========================================================================
# Production image tags (docker-compose.prod.yml)
# ===========================================================================
# Images publish to Docker Hub (docker.io/asolovov/evm-oracle-demo-*) from
# each service repo's Release workflow on merge to main — both a semantic
# `vX.Y.Z` tag and `latest`. Pin a version here, or leave `latest`.
IMAGE_TAG_PRICE=latest
IMAGE_TAG_ORACLE=latest
IMAGE_TAG_INDEXER=latest
IMAGE_TAG_API=latest

# ===========================================================================
# Telemetry
# ===========================================================================
LOG_LEVEL=info
ENV=dev
